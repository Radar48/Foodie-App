<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Back"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_button" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Food Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_navy"
                android:gravity="center" />
        </LinearLayout>

        <!-- Food Image -->
        <ImageView
            android:id="@+id/ivDetailImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_card"
            android:contentDescription="Food Detail Image" />

        <!-- Name & Price -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Food Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvDetailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KSh 450"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/food_primary_dark"
            android:layout_marginTop="4dp" />

        <!-- Category -->
        <TextView
            android:id="@+id/tvDetailCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: Burgers"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_navy"
            android:layout_marginTop="8dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description text goes here..."
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Quantity Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Quantity: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_navy" />

            <Button
                android:id="@+id/btnDetailMinus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_qty_button"
                android:padding="0dp" />

            <EditText
                android:id="@+id/etDetailQuantity"
                android:layout_width="70dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="1"
                android:inputType="number"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:background="@drawable/bg_quantity_box"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDetailPlus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="+"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_qty_button"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnDetailAddToCart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add to Cart"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_navy"
            android:background="@drawable/bg_search"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDetailOrderNow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Order Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_button" />

    </LinearLayout>
</ScrollView>
